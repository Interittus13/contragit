# ==============================================================================
# ContraGit Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your GitHub OAuth App credentials.
# Register a GitHub OAuth App at: https://github.com/settings/developers
# - Homepage URL: http://localhost:3000
# - Authorization Callback URL: http://localhost:3000/api/auth/callback
# ==============================================================================

# Required: GitHub OAuth Application Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Optional: Default target repository to pre-populate in the Studio Dashboard
REPO_OWNER=Interittus13
REPO_NAME=gitcontra

# Optional: GitHub username for optional profile follow action
GITHUB_FOLLOW_USER=Interittus13
