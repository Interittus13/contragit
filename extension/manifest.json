{
  "manifest_version": 3,
  "name": "ContraGit — Precision GitHub Studio",
  "version": "2.0.0",
  "description": "Architect your GitHub profile. Precision contribution graph scheduler, streak maintenance, and Git activity studio.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "ContraGit Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ]
}
